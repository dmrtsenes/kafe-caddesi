# ==============================================================================
# AdMob Production Ayarları (Android & iOS)
# ==============================================================================
# Canlı reklamları açmak için:
# VITE_ADMOB_MODE=production
#
# Android AdMob Reklam Birimi Kimlikleri (Ad Unit IDs):
# VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
#
# iOS AdMob Reklam Birimi Kimlikleri (App Store onayı sonrası Codemagic'e eklenir):
# İlk App Store incelemesinde boş bırakılırsa oyun %100 reklamsız (Test Ad olmadan) çalışır.
# VITE_IOS_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# VITE_IOS_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# IOS_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
#
# iOS App Store Mağaza Bağlantısı (Uygulama yayınlandıktan sonra puanlama/paylaşım için):
# VITE_IOS_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX

# İsteğe bağlı JS hata alıcısı. Boşsa rapor yalnız cihazda tutulur.
# VITE_CRASH_REPORT_URL=https://example.com/client-errors

# İsteğe bağlı telemetri alıcısı; oyuncu onay verirse gönderilir.
# VITE_TELEMETRY_URL=https://your-domain.example/events
